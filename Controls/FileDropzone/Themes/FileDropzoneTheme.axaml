<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fd="using:FileDiff.Controls"
                    xmlns:fdp="using:FileDiff.Controls.Primitives"
                    xmlns:fdm="using:FileDiff.Controls.Motion"
                    x:Class="FileDiff.Controls.FileDropzoneTheme">
    <!-- The drop target with its three sheets of paper, the refusal row, and the file list. -->
    <ControlTheme x:Key="{x:Type fd:FileDropzone}" TargetType="fd:FileDropzone">
        <Setter Property="fdm:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Foreground" Value="#0B0B0B" />
        <Setter Property="Template">
            <ControlTemplate TargetType="fd:FileDropzone">
                <Panel>
                    <StackPanel>
                        <Panel Name="PART_ZoneRoot" Background="Transparent">
                            <fd:FileDropzoneZone Name="PART_Zone"
                                                  AccentBrush="#353535"
                                                  RestingBorderBrush="#E9E9E9" />
                            <StackPanel>
                                <fd:FileDropzoneTrigger Name="PART_Trigger">
                                    <StackPanel>
                                        <fdp:SpringSizeDecorator Name="PART_IconSlot" Axis="Height" Spring="Smooth" IsExpanded="{TemplateBinding IsIconShown}">
                                            <Panel Width="36" Height="44" Margin="0,10,0,14" HorizontalAlignment="Center">
                                                <Border Name="PART_SheetBack" Classes="sheet">
                                                    <Panel>
                                                        <Border Classes="sheet-line" Width="16" Margin="7,8,0,0" />
                                                        <Border Classes="sheet-line" Width="11" Margin="7,13,0,0" />
                                                    </Panel>
                                                </Border>
                                                <Border Name="PART_SheetSide" Classes="sheet">
                                                    <Panel>
                                                        <Border Classes="sheet-line" Width="16" Margin="7,8,0,0" />
                                                        <Border Classes="sheet-line" Width="11" Margin="7,13,0,0" />
                                                    </Panel>
                                                </Border>
                                                <Border Name="PART_SheetFront" Classes="sheet">
                                                    <Panel>
                                                        <Border Classes="sheet-line" Width="16" Margin="7,8,0,0" />
                                                        <Border Classes="sheet-line" Width="11" Margin="7,13,0,0" />
                                                        <fd:ArcGlyph Name="PART_SheetArrow"
                                                                      Data="{x:Static fd:ArcIcons.ArrowUp}"
                                                                      Size="14"
                                                                      StrokeThickness="2"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Bottom"
                                                                      Margin="0,0,0,5"
                                                                      RenderTransformOrigin="50%,50%" />
                                                    </Panel>
                                                </Border>
                                            </Panel>
                                        </fdp:SpringSizeDecorator>
                                        <fdp:ArcContentSwap Name="PART_Label"
                                                            Mode="BlurSwap"
                                                            Content="{TemplateBinding DisplayLabel}"
                                                            HorizontalContentAlignment="Center"
                                                            TextElement.FontSize="14"
                                                            TextElement.FontWeight="Medium" />
                                        <TextBlock Name="PART_Description"
                                                   Margin="0,6,0,0"
                                                   Text="{TemplateBinding Description}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="#585858" />
                                        <fdp:SpringSizeDecorator Name="PART_NoteSlot" Axis="Height" Spring="Smooth" IsExpanded="{TemplateBinding IsNoteShown}">
                                            <TextBlock Name="PART_Note"
                                                       Padding="0,6,0,0"
                                                       Text="{TemplateBinding NoteText}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="#7D7D7D" />
                                        </fdp:SpringSizeDecorator>
                                    </StackPanel>
                                </fd:FileDropzoneTrigger>
                                <Decorator Name="PART_InsideHost" />
                            </StackPanel>
                        </Panel>
                        <fdp:SpringSizeDecorator Name="PART_ErrorSlot" Axis="Height" Spring="Smooth">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,12,0,0">
                                <fd:ArcGlyph Data="{x:Static fd:ArcIcons.CircleAlert}"
                                              Size="14"
                                              StrokeThickness="2.25"
                                              Margin="0,3,6,0"
                                              VerticalAlignment="Top"
                                              Foreground="#CD1526" />
                                <fdp:ArcContentSwap Grid.Column="1"
                                                    Mode="BlurSwap"
                                                    Content="{TemplateBinding ErrorMessage}"
                                                    TextElement.FontSize="14"
                                                    TextElement.Foreground="#CD1526">
                                    <fdp:ArcContentSwap.ContentTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{CompiledBinding .}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </fdp:ArcContentSwap.ContentTemplate>
                                </fdp:ArcContentSwap>
                            </Grid>
                        </fdp:SpringSizeDecorator>
                        <Decorator Name="PART_BelowHost" />
                    </StackPanel>
                    <fd:EditorsLiveRegion Name="PART_Status" />
                    <fd:EditorsLiveRegion Name="PART_Alert" IsAssertive="True" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- Rest, hover and press: color is the only press response; the target never scales. -->
        <Style Selector="^ /template/ fd|FileDropzoneZone#PART_Zone">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="34" />
            <Setter Property="EdgeBrush" Value="#C4C4C4" />
        </Style>
        <Style Selector="^ /template/ fd|FileDropzoneTrigger#PART_Trigger">
            <Setter Property="CornerRadius" Value="34" />
        </Style>
        <Style Selector="^:hovered /template/ fd|FileDropzoneZone#PART_Zone">
            <Setter Property="Background" Value="#F8F8F8" />
            <Setter Property="EdgeBrush" Value="#7D7D7D" />
        </Style>
        <Style Selector="^:trigger-pressed /template/ fd|FileDropzoneZone#PART_Zone">
            <Setter Property="Background" Value="#F8F8F8" />
        </Style>
        <Style Selector="^:dragover /template/ fd|FileDropzoneZone#PART_Zone">
            <Setter Property="Solid" Value="1" />
        </Style>
        <!-- A folded prompt is a slimmer surface, so its corners step down to the panel radius. -->
        <Style Selector="^:compact /template/ fd|FileDropzoneZone#PART_Zone">
            <Setter Property="CornerRadius" Value="26" />
        </Style>
        <Style Selector="^:compact /template/ fd|FileDropzoneTrigger#PART_Trigger">
            <Setter Property="CornerRadius" Value="26" />
        </Style>
        <Style Selector="^ /template/ fd|FileDropzoneTrigger#PART_Trigger">
            <Setter Property="Padding" Value="20,26,20,34" />
        </Style>
        <Style Selector="^:rows-inside /template/ fd|FileDropzoneTrigger#PART_Trigger">
            <Setter Property="Padding" Value="20,26,20,26" />
        </Style>
        <Style Selector="^:compact /template/ fd|FileDropzoneTrigger#PART_Trigger">
            <Setter Property="Padding" Value="20,16,20,16" />
        </Style>
        <Style Selector="^:compact:rows-inside /template/ fd|FileDropzoneTrigger#PART_Trigger">
            <Setter Property="Padding" Value="20,16,20,8" />
        </Style>
        <Style Selector="^:error /template/ fdp|SpringSizeDecorator#PART_ErrorSlot">
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <Style Selector="^ /template/ fdp|SpringSizeDecorator#PART_ErrorSlot">
            <Setter Property="IsExpanded" Value="False" />
        </Style>
        <!-- The list's own padding opens with the first row, so the gap never appears in one frame. -->
        <Style Selector="^:has-rows /template/ Decorator#PART_BelowHost">
            <Setter Property="Padding" Value="0,4,0,0" />
        </Style>
        <Style Selector="^:inside /template/ Decorator#PART_InsideHost">
            <Setter Property="Padding" Value="12,0,12,0" />
        </Style>
        <Style Selector="^:rows-inside /template/ Decorator#PART_InsideHost">
            <Setter Property="Padding" Value="12,0,12,12" />
        </Style>

        <!-- Three sheets of paper: they fan open on hover and spread wider under a file. -->
        <Style Selector="^ /template/ Border.sheet">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E9E9E9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BoxShadow" Value="0 1 2 0 #0D000000, 0 3 8 0 #0A000000" />
            <Setter Property="TextElement.Foreground" Value="#7D7D7D" />
            <Setter Property="RenderTransformOrigin" Value="50%,100%" />
        </Style>
        <Style Selector="^ /template/ Border.sheet-line">
            <Setter Property="Height" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="#7D7D7D" />
        </Style>
        <Style Selector="^ /template/ fd|ArcGlyph#PART_SheetArrow">
            <Setter Property="Foreground" Value="#7D7D7D" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <Style Selector="^ /template/ Border#PART_SheetBack">
            <Setter Property="RenderTransform" Value="translate(-9px, 2px) rotate(-10deg)" />
        </Style>
        <Style Selector="^ /template/ Border#PART_SheetSide">
            <Setter Property="RenderTransform" Value="translate(9px, 2px) rotate(10deg)" />
        </Style>
        <Style Selector="^ /template/ Border#PART_SheetFront">
            <Setter Property="RenderTransform" Value="translate(0px, 0px) rotate(0deg)" />
        </Style>
        <Style Selector="^:hovered /template/ Border#PART_SheetBack">
            <Setter Property="RenderTransform" Value="translate(-13px, 2px) rotate(-15deg)" />
        </Style>
        <Style Selector="^:hovered /template/ Border#PART_SheetSide">
            <Setter Property="RenderTransform" Value="translate(13px, 2px) rotate(15deg)" />
        </Style>
        <Style Selector="^:hovered /template/ Border#PART_SheetFront">
            <Setter Property="RenderTransform" Value="translate(0px, -2px) rotate(0deg)" />
        </Style>
        <Style Selector="^:dragover /template/ Border.sheet">
            <Setter Property="BorderBrush" Value="#C4C4C4" />
        </Style>
        <Style Selector="^:dragover /template/ Border.sheet-line">
            <Setter Property="Background" Value="#585858" />
        </Style>
        <Style Selector="^:dragover /template/ fd|ArcGlyph#PART_SheetArrow">
            <Setter Property="Foreground" Value="#585858" />
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
        </Style>
        <Style Selector="^:dragover /template/ Border#PART_SheetBack">
            <Setter Property="RenderTransform" Value="translate(-20px, -2px) rotate(-22deg)" />
        </Style>
        <Style Selector="^:dragover /template/ Border#PART_SheetSide">
            <Setter Property="RenderTransform" Value="translate(20px, -2px) rotate(22deg)" />
        </Style>
        <Style Selector="^:dragover /template/ Border#PART_SheetFront">
            <Setter Property="RenderTransform" Value="translate(0px, -8px) rotate(0deg)" />
        </Style>

        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ fd|FileDropzoneZone#PART_Zone">
                <Setter Property="Transitions">
                    <Transitions>
                        <fdm:ArcBrushTransition Property="Background" Tween="Standard" />
                        <fdm:ArcBrushTransition Property="EdgeBrush" Tween="Fast" />
                        <fdm:ArcDoubleTransition Property="Solid" Tween="Standard" />
                        <fdm:SpringCornerRadiusTransition Property="CornerRadius" Spring="Smooth" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ fd|FileDropzoneTrigger#PART_Trigger">
                <Setter Property="Transitions">
                    <Transitions>
                        <fdm:SpringThicknessTransition Property="Padding" Spring="Smooth" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Decorator#PART_BelowHost">
                <Setter Property="Transitions">
                    <Transitions>
                        <fdm:SpringThicknessTransition Property="Padding" Spring="Smooth" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Decorator#PART_InsideHost">
                <Setter Property="Transitions">
                    <Transitions>
                        <fdm:SpringThicknessTransition Property="Padding" Spring="Smooth" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border.sheet">
                <Setter Property="Transitions">
                    <Transitions>
                        <fdm:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                        <fdm:ArcBrushTransition Property="BorderBrush" Tween="Standard" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ fd|ArcGlyph#PART_SheetArrow">
                <Setter Property="Transitions">
                    <Transitions>
                        <fdm:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                        <fdm:ArcBrushTransition Property="Foreground" Tween="Standard" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type fd:FileDropzoneTrigger}" TargetType="fd:FileDropzoneTrigger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#0B0B0B" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="fd:FileDropzoneTrigger">
                <Panel>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Stretch" />
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-3"
                            BorderThickness="2"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="#B81F1F1F" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type fd:FileDropzoneProgressBar}" TargetType="fd:FileDropzoneProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="TrackBrush" Value="#E9E9E9" />
        <Setter Property="FillBrush" Value="#353535" />
    </ControlTheme>

    <!-- A file row: 40px thumbnail or type icon, name and status, then Retry and Remove. -->
    <ControlTheme x:Key="{x:Type fd:FileDropzoneRow}" TargetType="fd:FileDropzoneRow">
        <Setter Property="fdm:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="fd:FileDropzoneRow">
                <Border Name="PART_Frame"
                        Margin="0,8,0,0"
                        MinHeight="58"
                        Padding="9,8,8,8"
                        BorderThickness="1"
                        CornerRadius="18"
                        Background="#FFFFFF">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Name="PART_Icon" Width="40" Height="40" VerticalAlignment="Center">
                            <fd:ArcGlyph Name="PART_TypeIcon"
                                          Data="{TemplateBinding TypeIcon}"
                                          Size="20"
                                          StrokeThickness="1.75"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="#585858" />
                            <Border Name="PART_Thumb"
                                    ClipToBounds="True"
                                    CornerRadius="10"
                                    Background="#F8F8F8">
                                <Image Source="{TemplateBinding Preview}" Stretch="UniformToFill" />
                            </Border>
                        </Panel>
                        <StackPanel Name="PART_Copy" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding NameText}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#0B0B0B" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,1,0,0"
                                        TextElement.FontSize="12"
                                        TextElement.Foreground="#7D7D7D">
                                <TextBlock Text="{TemplateBinding SizeText}" VerticalAlignment="Center" />
                                <TextBlock Text="·" Margin="6,0" VerticalAlignment="Center" IsVisible="{TemplateBinding HasPhase}" />
                                <fdp:ArcContentSwap Mode="BlurSwap" Content="{TemplateBinding PhaseContent}" VerticalAlignment="Center" />
                            </StackPanel>
                            <fdp:SpringSizeDecorator Axis="Height" Spring="Smooth" IsExpanded="{TemplateBinding IsBarOpen}">
                                <fd:FileDropzoneProgressBar Name="PART_Bar" Margin="0,7,0,2" />
                            </fdp:SpringSizeDecorator>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <fdp:SpringSizeDecorator Axis="Width" Spring="Smooth" IsExpanded="{TemplateBinding CanRetry}">
                                <fd:FileDropzoneActionButton Name="PART_Retry" Classes="retry" Margin="3,3,6,3" IsVisible="{TemplateBinding CanRetry}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <fd:ArcGlyph Data="{x:Static fd:ArcIcons.RotateCw}" Size="14" StrokeThickness="2" VerticalAlignment="Center" />
                                        <TextBlock Name="PART_RetryLabel" Text="Retry" VerticalAlignment="Center" />
                                    </StackPanel>
                                </fd:FileDropzoneActionButton>
                            </fdp:SpringSizeDecorator>
                            <fd:FileDropzoneActionButton Name="PART_Remove" Classes="remove">
                                <fd:ArcGlyph Data="{x:Static fd:ArcIcons.X}" Size="16" StrokeThickness="1.75" />
                            </fd:FileDropzoneActionButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#PART_Frame">
            <Setter Property="BorderBrush" Value="#E9E9E9" />
        </Style>
        <Style Selector="^:failed /template/ Border#PART_Frame">
            <Setter Property="BorderBrush" Value="#EABBB6" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Thumb">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ StackPanel#PART_Copy">
            <Setter Property="Margin" Value="12,0" />
        </Style>
        <Style Selector="^:thumb /template/ Border#PART_Thumb">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:thumb /template/ fd|ArcGlyph#PART_TypeIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- On narrow lists Retry keeps only its icon; on the narrowest the type icon steps aside. -->
        <Style Selector="^:narrow /template/ TextBlock#PART_RetryLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:narrow /template/ fd|FileDropzoneActionButton#PART_Retry">
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^:tiny /template/ Panel#PART_Icon">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:tiny /template/ StackPanel#PART_Copy">
            <Setter Property="Margin" Value="5,0,12,0" />
        </Style>
        <Style Selector="^:motion-full /template/ Border#PART_Frame">
            <Setter Property="Transitions">
                <Transitions>
                    <fdm:ArcBrushTransition Property="BorderBrush" Tween="Standard" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- Retry is a bordered pill with a label; Remove a round icon button. Quick press, spring release. -->
    <ControlTheme x:Key="{x:Type fd:FileDropzoneActionButton}" TargetType="fd:FileDropzoneActionButton">
        <Setter Property="fdm:ArcMotion.Tracks" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#585858" />
        <Setter Property="CornerRadius" Value="9999" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Template">
            <ControlTemplate TargetType="fd:FileDropzoneActionButton">
                <Panel>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-3"
                            BorderThickness="2"
                            CornerRadius="9999"
                            BorderBrush="#B81F1F1F" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^.remove">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#F8F8F8" />
                <Setter Property="Foreground" Value="#0B0B0B" />
            </Style>
        </Style>
        <Style Selector="^.retry">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E9E9E9" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0B0B0B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="#C4C4C4" />
                <Setter Property="Background" Value="#F8F8F8" />
            </Style>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <fdm:ArcBrushTransition Property="Background" />
                    <fdm:ArcBrushTransition Property="Foreground" />
                    <fdm:ArcBrushTransition Property="BorderBrush" />
                    <fdm:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                </Transitions>
            </Setter>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)" />
                <Setter Property="Transitions">
                    <Transitions>
                        <fdm:ArcTransformOperationsTransition Property="RenderTransform" Tween="Instant" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
